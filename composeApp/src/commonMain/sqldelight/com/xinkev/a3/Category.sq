CREATE TABLE Category (
    uuid TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL UNIQUE,
    icon TEXT NOT NULL
);

-- Insert data
insert:
INSERT OR IGNORE INTO Category (uuid, name, icon)
VALUES (?, ?, ?);

-- Update data
update:
UPDATE Category
SET name = ?, icon = ?
WHERE uuid = ?;

-- Delete
delete:
DELETE FROM Category
WHERE uuid = ?;

-- Select All
selectAll:
SELECT * FROM Category;

-- Check if name is already in the table
selectByName:
SELECT * FROM Category
WHERE name = ?;
