-- Create table
CREATE TABLE Expenses (
    uuid TEXT PRIMARY KEY NOT NULL,
    detail TEXT NOT NULL,
    datetime TEXT NOT NULL, -- ISO 8601
    categoryId TEXT NOT NULL REFERENCES Category(uuid) ON DELETE CASCADE,
    cost REAL NOT NULL
);

-- Insert data
insert:
INSERT OR IGNORE INTO Expenses (uuid, detail, datetime, categoryId, cost)
VALUES (?, ?, ?, ?, ?);

-- Read data
selectAll:
SELECT Expenses.*, Category.name categoryName, Category.icon categoryIcon
FROM Expenses
INNER JOIN Category ON Expenses.categoryId = Category.uuid
ORDER BY datetime ASC;

selectByDateTime:
SELECT Expenses.*, Category.name categoryName, Category.icon categoryIcon
FROM Expenses
JOIN Category ON Expenses.categoryId = Category.uuid
WHERE
    date(datetime) = date(?)
ORDER BY datetime ASC ;

getMonthlyTotalExpense:
SELECT sum(cost) totalAmount
FROM Expenses
WHERE strftime('%Y-%m', datetime) = strftime('%Y-%m', ?);

getDailyTotalExpense:
SELECT sum(cost) totalAmount
FROM Expenses
WHERE strftime('%Y-%m-%d', datetime) = strftime('%Y-%m-%d', ?);


-- Update data
update:
UPDATE Expenses
SET detail = ?, 
    datetime = ?, 
    categoryId = ?, 
    cost = ?
WHERE uuid = ?;

-- Delete data
delete:
DELETE FROM Expenses
WHERE uuid = ?;
